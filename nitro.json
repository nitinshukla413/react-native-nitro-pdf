{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitropdf"],
  "ios": {
    "iosModuleName": "NitroPdf"
  },
  "android": {
    "androidNamespace": ["nitropdf"],
    "androidCxxLibName": "NitroPdf"
  },
  "autolinking": {
    "NitroPdf": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNitroPdf"
      }
    },
    "PdfView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPdfView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPdfView"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
